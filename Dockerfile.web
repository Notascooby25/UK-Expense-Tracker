# Multi-stage Dockerfile for UK Expense Tracker Web (React + FastAPI)

# Stage 1: Build the React frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci || npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Python runtime
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
	libjpeg-dev \
	libpng-dev \
	zlib1g-dev \
	libfreetype6-dev \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend and shared application files
COPY cashflow_utils.py .
COPY backend/ ./backend/

# Copy built frontend static assets
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

ENV EXPENSE_TRACKER_DATA_DIR=/app/data
ENV EXPENSE_TRACKER_ENV=production

EXPOSE 8502
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8502"]
